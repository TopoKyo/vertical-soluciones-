{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Represents a project in the company portfolio.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string", "format": "uri", "description": "Main cover image" },
        "gallery": { 
          "type": "array", 
          "items": { "type": "string", "format": "uri" },
          "description": "Additional project photos"
        },
        "serviceProvided": { "type": "string", "description": "Servicio prestado" },
        "client": { "type": "string", "description": "Mandante" },
        "contractedBy": { "type": "string", "description": "Contratado por" },
        "location": { "type": "string", "description": "Ubicación" },
        "executionDate": { "type": "string", "description": "Fecha de ejecución" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "description", "image", "client", "createdAt"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Company wide settings like contact information and AI behavior.",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "aiPrompt": { "type": "string", "description": "Knowledge base and personality for the AI Chatbot." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["phone", "email", "address"]
    },
    "Message": {
      "title": "Message",
      "description": "Information submitted via contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "company": { "type": "string" },
        "email": { "type": "string" },
        "service": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "details", "createdAt"]
    }
  },
  "firestore": {
    "projects": {
      "schema": "Project",
      "description": "Collection of portfolio projects."
    },
    "settings": {
      "schema": "Settings",
      "description": "Global application settings."
    },
    "messages": {
      "schema": "Message",
      "description": "Customer contact messages."
    }
  }
}
