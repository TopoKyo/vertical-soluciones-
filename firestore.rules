rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'chinchuarchibo@gmail.com' || request.auth.token.email.lower() == 'johnverticalvs@gmail.com');
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'category', 'description', 'image', 'client', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.description is string && data.description.size() <= 10000 &&
             data.image is string && data.image.size() <= 5000000 &&
             data.client is string && data.client.size() <= 200 &&
             data.createdAt is timestamp &&
             data.get('gallery', []) is list && data.get('gallery', []).size() <= 50 &&
             data.get('serviceProvided', '') is string && data.get('serviceProvided', '').size() <= 1000 &&
             data.get('contractedBy', '') is string && data.get('contractedBy', '').size() <= 500 &&
             data.get('location', '') is string && data.get('location', '').size() <= 500 &&
             data.get('executionDate', '') is string && data.get('executionDate', '').size() <= 200 &&
             data.get('updatedAt', request.time) is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['phone', 'email', 'address']) &&
             data.phone is string && data.phone.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             data.address is string && data.address.size() <= 500 &&
             data.get('heroTagline', '') is string && data.get('heroTagline', '').size() <= 500 &&
             data.get('heroTitleLine1', '') is string && data.get('heroTitleLine1', '').size() <= 500 &&
             data.get('heroTitleLine2', '') is string && data.get('heroTitleLine2', '').size() <= 500 &&
             data.get('heroTitleLine3', '') is string && data.get('heroTitleLine3', '').size() <= 500 &&
             data.get('heroTitleHighlight', '') is string && data.get('heroTitleHighlight', '').size() <= 500 &&
             data.get('heroDescription', '') is string && data.get('heroDescription', '').size() <= 5000 &&
             data.get('latestProjectId', '') is string && data.get('latestProjectId', '').size() <= 128 &&
             data.get('updatedAt', request.time) is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'details', 'createdAt']) &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.details is string && data.details.size() <= 10000 &&
             data.createdAt is timestamp &&
             data.get('company', '') is string && data.get('company', '').size() <= 200 &&
             data.get('service', '') is string && data.get('service', '').size() <= 200;
    }

    function isValidJobApplication(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'experience', 'createdAt']) &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.phone is string && data.phone.size() <= 100 &&
             data.experience is string && data.experience.size() <= 10000 &&
             data.createdAt is timestamp &&
             data.get('certifications', '') is string && data.get('certifications', '').size() <= 5000 &&
             data.get('portfolioUrl', '') is string && data.get('portfolioUrl', '').size() <= 500;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['title', 'slug', 'content', 'category', 'authorId', 'authorName', 'status', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.slug is string && data.slug.size() <= 250 &&
             data.content is string && data.content.size() <= 50000 &&
             data.category is string && data.category.size() <= 100 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() <= 200 &&
             data.status is string && data.status in ['Publicada', 'Borrador', 'Oculta', 'Destacada'] &&
             data.createdAt is timestamp &&
             data.get('excerpt', '') is string && data.get('excerpt', '').size() <= 1000 &&
             data.get('image', '') is string && data.get('image', '').size() <= 5000000 &&
             data.get('tags', []) is list && data.get('tags', []).size() <= 20 &&
             data.get('updatedAt', request.time) is timestamp &&
             data.get('publishedAt', request.time) is timestamp &&
             data.get('likes', 0) is number &&
             data.get('commentsCount', 0) is number &&
             data.get('featured', false) is bool;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['postId', 'content', 'authorName', 'createdAt']) &&
             data.postId is string && data.postId.size() <= 128 &&
             data.content is string && data.content.size() <= 5000 &&
             data.authorName is string && data.authorName.size() <= 200 &&
             data.createdAt is timestamp &&
             data.get('authorId', '') is string && data.get('authorId', '').size() <= 128 &&
             data.get('parentId', null) is string &&
             data.get('likes', 0) is number;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProject(incoming());
      allow update: if isAdmin() && isValidProject(incoming()) && 
                    incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidSettings(incoming());
    }

    match /messages/{messageId} {
      allow create: if isValidMessage(incoming());
      allow read, delete: if isAdmin();
    }

    match /job_applications/{applicationId} {
      allow create: if isValidJobApplication(incoming());
      allow read, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if existing().status in ['Publicada', 'Destacada'] || isAdmin();
      allow create: if isAdmin() && isValidPost(incoming());
      allow update: if isAdmin() && isValidPost(incoming()) || 
                    (existing().status in ['Publicada', 'Destacada'] && incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'commentsCount']));
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidComment(incoming());
      allow update: if incoming().diff(existing()).affectedKeys().hasOnly(['likes']) || 
                    (isSignedIn() && request.auth.uid == existing().authorId && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt']));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == existing().authorId);
    }
  }
}
